# Database
DATABASE_URL=mysql+pymysql://nextvine:nextvine@db:3306/nextvine?charset=utf8mb4

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production

# Apple 소셜 로그인
APPLE_CLIENT_ID=com.nextvine.scolioscan
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key-before-deployment

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=NextVine
ADMIN_EMAIL=admin@nextvine.com

# Daum Address API
DAUM_ADDRESS_API_KEY=your-daum-api-key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
