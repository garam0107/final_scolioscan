# NextVine Backend Environment Variables

# Database Settings
DATABASE_URL=mysql+pymysql://username:password@host:port/database?charset=utf8mb4

# JWT Settings
SECRET_KEY=your-secret-key-here

# Apple 소셜 로그인
APPLE_CLIENT_ID=com.nextvine.scolioscan
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key-before-deployment

# SMTP Settings (for sending emails)
# Gmail: 포트 587 (TLS), Daum/Kakao: 포트 465 (SSL)
SMTP_HOST=smtp.daum.net
SMTP_PORT=465
SMTP_USER=your-email@daum.net
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@daum.net
SMTP_FROM_NAME=NextVine
SMTP_SSL=true

# Admin Email (문의 메일이 발송될 주소)
ADMIN_EMAIL=nextvinedev@gmail.com

# OCTOMO SMS 인증 설정
# 실제 문서에 맞는 인증 헤더 이름과 접두어를 확인해서 수정하세요.
OCTOMO_API_BASE_URL=https://api.octoverse.kr/octomo/v1/public
OCTOMO_API_KEY=
OCTOMO_API_KEY_HEADER=Authorization
OCTOMO_API_KEY_PREFIX=Octomo 
OCTOMO_HTTP_TIMEOUT_SECONDS=10
OCTOMO_VERIFICATION_TTL_SECONDS=300
OCTOMO_RECIPIENT_NUMBER=1666-3538

# S3 설정
AWS_ACCESS_KEY_ID=발급받은값
AWS_SECRET_ACCESS_KEY=발급받은값
AWS_REGION=ap-northeast-2
S3_BUCKET=버킷이름
S3_PREFIX=ais-images
