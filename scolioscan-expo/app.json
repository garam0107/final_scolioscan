{
  "expo": {
    "name": "Scolioscan",
    "slug": "scolioscan-expo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icons/scolioscan_icon.png",
    "splash": {
      "image": "./assets/icons/splash_icon.png"
    },
    "scheme": "scolioscan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/icons/scolioscan_icon_ios.png",
      "bundleIdentifier": "com.nextvine.scolioscan",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMotionUsageDescription": "척추측만계 측정을 위해 기기의 움직임 센서를 사용합니다.",
        "NSLocationWhenInUseUsageDescription": "계정 보안을 위해 현재 로그인 기기의 위치를 표시하는 데 위치 정보를 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#22BCB7",
        "foregroundImage": "./assets/icons/scolioscan_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nextvine.scolioscan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withShortCmakePath.js",
      "./plugins/withCleartextTraffic.js",
      "./plugins/withBlockedAndroidPermissions.js",
      "./plugins/withPhoneOnlyAndroidScreens.js",
      "./plugins/withFinishBackButtonTask.js",
      "./plugins/withGoogleSigninCodegenSource.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#22BCB7",
          "dark": {
            "backgroundColor": "#22BCB7"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.134913920767-k5n471ojmnjbbh74vg63n4g9ugi47dbk"
        }
      ],
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "scolioscannaver"
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "928ff7803adb922ff7ecf311fb62e2be",
          "kotlinVersion": "2.1.20"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Thin.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/fonts/Pretendard-ExtraLight.ttf",
                    "weight": 200
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Pretendard-ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": [
            "./assets/fonts/Pretendard-Regular.ttf",
            "./assets/fonts/Pretendard-Medium.ttf",
            "./assets/fonts/Pretendard-SemiBold.ttf",
            "./assets/fonts/Pretendard-Bold.ttf",
            "./assets/fonts/Pretendard-ExtraBold.ttf",
            "./assets/fonts/Pretendard-Black.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "문의에 스크린샷을 첨부하기 위해 사진 보관함 접근 권한을 사용합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "계정 보안을 위해 현재 로그인 기기의 위치를 표시하는 데 위치 정보를 사용합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "2D 측정을 위해 카메라로 자세를 촬영합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5",
            "extraPods": [
              {
                "name": "AppCheckCore",
                "version": "11.2.0"
              }
            ]
          },
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ],
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3142664726693803~7730146315",
          "iosAppId": "ca-app-pub-3142664726693803~3651446298",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e19dda78-f8f0-43c8-9530-f4675d08c87a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e19dda78-f8f0-43c8-9530-f4675d08c87a"
    }
  }
}
